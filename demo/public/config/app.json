{
  "title": "仙林校区无人机适航评估平台",
  "ui": {
    "showLegacyTools": false,
    "showQuickLogin": false
  },
  "campusCenter": { "lng": 118.944736, "lat": 32.107470, "height": 480 },
  "tileset3d": {
    "url": "./3dtiles/tileset.json",
    "enabled": true,
    "maximumScreenSpaceError": 16,
    "heightOffset": 0
  },
  "fallbackModel": {
    "url": "./Models/campus-model2.glb",
    "position": { "lng": 118.944736, "lat": 32.107470, "height": 0 },
    "scale": 100,
    "enabled": true
  },
  "campusBuildings": {
    "enabled": false,
    "url": "./data/campus-buildings.geojson"
  },
  "droneModel": {
    "url": "./Models/parrot_camo_drone.glb",
    "minimumPixelSize": 24,
    "scale": 1.5,
    "maximumScale": 90,
    "headingOffset": 90
  },
  "terrain": {
    "enabled": true,
    "url": "./terrain"
  },
  "imagery": {
    "enabled": true,
    "fallbackUrl": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
    "maximumLevel": 19,
    "credit": "Tiles © Esri"
  },
  "grid": {
    "groundHeight": 55,
    "alpha": 0.7,
    "bboxLimit": 6000,
    "loadOnCameraMove": true,
    "viewPadding": 0.0003,
    "reloadDebounceMs": 350,
    "zMin": 0,
    "zMax": 200,
    "useDemoWhenOffline": false,
    "showOutlines": false,
    "minBoxHeight": 6,
    "dynamicRefreshSeconds": 30,
    "weatherFreshnessMinutes": 30,
    "defaultWeather": {
      "enabled": true,
      "windSpeed": 3,
      "precipitation": 0,
      "visibility": 5000
    }
  },
  "defaultLayers": {
    "terrain": true,
    "tileset": true,
    "fallbackModel": true,
    "buildings": false,
    "heatmap": false,
    "grid": true,
    "route": false,
    "drone": true
  },
  "routePlan": {
    "placesUrl": "./data/places.json",
    "defaultFlightHeight": 80,
    "alignToModel": true,
    "placeCoordinateMode": "modelLocalMeters",
    "searchBbox": {
      "minPad": 0.002,
      "ratio": 0.3
    },
    "minScore": 0.25,
    "gridSize": 48,
    "simplifyToleranceMeters": 8,
    "showSearchBbox": true
  },
  "apiBase": "/api"
}
