PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=replace_with_your_local_password
PG_DATABASE=nanjing_uni_grid_score
# 如果V3数据库使用不同的连接账号，可取消下面注释并单独配置；否则自动沿用PG_*。
# PG_V3_HOST=localhost
# PG_V3_PORT=5432
# PG_V3_USER=postgres
# PG_V3_PASSWORD=change_me
PG_V3_DATABASE=nanjing_uni_grid_v3_test
PG_V3_POOL_MAX=4
PG_V3_READ_ONLY=true
PG_V3_WRITE_POOL_MAX=4
AUTO_REPLAN_ENABLED=true
AUTO_REPLAN_DEBOUNCE_MS=750
AUTO_REPLAN_COST_THRESHOLD_PERCENT=0.5
SKYNEST_TIME_ZONE=Asia/Shanghai
# 默认只使用V3确定性规则；开启后语言模型也仅负责解释，不能改风险、机型和审批结果。
LLM_ENABLED=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# 使用百炼时将LLM_PROVIDER改为dashscope，并只在服务端配置密钥。
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# 使用DeepSeek时将LLM_PROVIDER改为deepseek，并只在服务端配置密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_FALLBACK_ENABLED=true
LLM_TIMEOUT_MS=90000
# 师生端自然语言结构化提取；密钥只放服务端，未配置时自动回退本地规则。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=30000
# 前端可用 VITE_V3_WORKFLOW_MODE=mock 临时切回本地演示任务。
PORT=3001

# 本地比赛演示默认启用三类账号；生产环境会自动禁用，届时必须配置独立密码。
AUTH_ALLOW_DEMO_USERS=true
AUTH_SESSION_TTL_HOURS=8
# AUTH_STUDENT_USERNAME=student
# AUTH_STUDENT_PASSWORD=请设置师生端密码
# AUTH_STUDENT_NAME=万理
# AUTH_STUDENT_DEPARTMENT=南京大学师生
# AUTH_SCHOOL_USERNAME=school
# AUTH_SCHOOL_PASSWORD=请设置校方端密码
# AUTH_OPERATOR_USERNAME=operator
# AUTH_OPERATOR_PASSWORD=请设置运营端密码
